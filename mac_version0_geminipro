import os
import time
import json
import subprocess
from datetime import datetime
import pytz
from PIL import Image, ImageDraw, ImageFont

def load_config():
    with open('config.json', 'r') as f:
        return json.load(f)

def set_macos_wallpaper(image_path):
    """
    Uses the native macOS AppleScript engine to safely update the desktop 
    background image across all active spaces.
    """
    script = f'''
    tell application "System Events"
        tell every desktop
            set picture to "{image_path}"
        end tell
    end tell
    '''
    try:
        subprocess.run(["osascript", "-e", script], check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error setting macOS wallpaper: {e}")

def generate_wallpaper(config):
    # Load the base user-uploaded image
    with Image.open(config["image_path"]) as img:
        base_img = img.convert("RGB")
        draw = ImageDraw.Draw(base_img)
        
        # Pull exact South African Standard Time (SAST)
        sa_tz = pytz.timezone('Africa/Johannesburg')
        sa_time = datetime.now(sa_tz).strftime("%H:%M")
        
        # Load a default native macOS system font
        # San Francisco or Helvetica Neue are standard on macOS
        try:
            font = ImageFont.truetype("/System/Library/Fonts/Helvetica.ttc", config["font_size"])
        except IOError:
            try:
                font = ImageFont.truetype("/System/Library/Fonts/Cache/Arial.ttf", config["font_size"])
            except IOError:
                font = ImageFont.load_default()
            
        # Composite the live text onto the background image
        draw.text(
            tuple(config["position"]), 
            sa_time, 
            fill=tuple(config["text_color"]), 
            font=font
        )
        
        # Save to a temporary file path
        # macOS treats /tmp/ as a shared secure temporary folder
        tmp_path = os.path.abspath("/tmp/current_wallpaper.jpg")
        base_img.save(tmp_path, "JPEG", quality=90)
        
        # Execute the native desktop update
        set_macos_wallpaper(tmp_path)

def main():
    print("Starting SA Wallpaper Service for macOS...")
    while True:
        try:
            config = load_config()
            generate_wallpaper(config)
        except Exception as e:
            print(f"Execution error: {e}")
            
        # Enforce complete execution pause to drop CPU consumption to zero
        time.sleep(config.get("update_interval_seconds", 60))

if __name__ == "__main__":
    main()
Implementation Notes & macOS Privileges
System Permissions: The first time you execute this script in your terminal, macOS may prompt you with a system dialog requesting permission for your terminal emulator (e.g., Terminal, iTerm2, or VS Code) to control "System Events". You must click Allow so the AppleScript can change the wallpaper.

Absolute Paths: Unlike Linux, macOS AppleScript explicitly requires an absolute path (/tmp/current_wallpaper.jpg) rather than relative structures to target files correctly, which is why os.path.abspath() is explicitly called out in the code.

Multi-Monitor Support: The AppleScript directive tell every desktop automatically scales across multi-display setups, changing the wallpaper and updating the time on all connected monitors simultaneously.

